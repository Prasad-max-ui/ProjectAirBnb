<% layout("/layouts/boilerplate") -%>


    <body>
        <h2 class="mt-3">Edit post of <%= listing.title %>
        </h2>
        <div class="col-8 offset-2">

            <form action="/listing/<%= listing._id %>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title">Enter title :</label><input type="text" name="title" class="form-control"
                        value="<%= listing.title %>" required>

                    <div class="valid-feedback"> title Looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="description">Enter description :</label> <textarea name="description"
                        class="form-control" required><%= listing.description %></textarea>
                    <div class="invalid-feedback">Enter a short Description</div>
                </div>
                <div class="mb-3">
                    Original Listing Img <br>
                    <img src="<%=originalImageUrl %>" alt="original img">
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label"> Upload New Listing Image :</label> <input type="file" name="image" class="form-control"  >
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price">Enter price :</label> <input type="number" name="price" class="form-control"
                            value="<%= listing.price %>" required>
                        <div class="invalid-feedback">Price Should be Valid</div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country">Enter country : </label><input type="text" name="country"
                            class="form-control" value="<%= listing.country %>" required>
                        <div class="invalid-feedback"> Country name should be valid </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location">Enter location : </label> <input type="text" name="location"
                        class="form-control" value="<%= listing.location %>" required>
                    <div class="invalid-feedback"> Location name should be valid </div>
                </div>

                <button type="submit" class="btn add-btn mt-3">Update Listing</button>
            </form>
        </div>
    </body>