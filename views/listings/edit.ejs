<% layout("/layouts/boilerplate") -%>


    <body>
        <h2 class="mt-3">Edit post of <%= listing.title %>
        </h2>

        <form action="/listing/<%= listing._id %>?_method=PUT" method="POST">
            <div class="mb-3">
                <label for="title">Enter title :</label><input type="text" name="title" class="form-control"
                    value="<%= listing.title %>">
            </div>
            <div class="mb-3">
                <label for="description">Enter description :</label> <textarea name="description"
                    class="form-control"><%= listing.description %></textarea>
            </div>
            <div class="mb-3">
                <label for="image"> Enter image URL :</label> <input type="text" name="image" class="form-control"
                    value="<%= listing.image.url %>">
            </div>
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price">Enter price :</label> <input type="number" name="price" class="form-control"
                        value="<%= listing.price %>">
                </div>
                <div class="mb-3 col-md-8">
                    <label for="country">Enter country : </label><input type="text" name="country" class="form-control"
                        value="<%= listing.country %>">
                </div>
            </div>
            <div class="mb-3">
                <label for="location">Enter location : </label> <input type="text" name="location" class="form-control"
                    value="<%= listing.location %>">
            </div>

            <button type="submit" class="btn add-btn mt-3" >Update Listing</button>
        </form>
    </body>